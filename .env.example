# ===== AMBIENTE =====
NODE_ENV=production
PORT=3002
HOST=0.0.0.0
TRUST_PROXY=1

# ===== DOMINIO =====
DOMAIN=resi.tuo-dominio.it
CORS_ORIGIN=https://resi.tuo-dominio.it

# ===== DATABASE SQLCipher =====
DB_ENCRYPTION_KEY=                    # openssl rand -hex 32
DB_PATH=./data/resi.db

# ===== BACKUP AUTOMATICO DB (VACUUM INTO, snapshot coerente col WAL) =====
# Un backup poco dopo l'avvio + uno giornaliero all'ora indicata; si conservano
# gli ultimi BACKUP_RETENTION_DAYS giorni (GDPR Art. 5 limitazione conservazione).
# I file finiscono in <percorso DB>/backups/ e sono cifrati con la stessa chiave.
# DB_BACKUP_AUTO=0                        # disattiva
# BACKUP_HOUR=3                          # ora locale del backup giornaliero
# BACKUP_RETENTION_DAYS=30

# ===== JWT RS256 =====
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===== WEBHOOK VERSO ABC HUB (localhost!) =====
ABC_HUB_WEBHOOK_URL=http://127.0.0.1:3001/api/resi
WEBHOOK_SECRET=                       # openssl rand -base64 64
WEBHOOK_RETRY_MAX=3
WEBHOOK_RETRY_DELAYS=5000,30000,300000

# ===== PASSWORD PEPPER =====
PASSWORD_PEPPER=                      # openssl rand -base64 32

# ===== SESSION =====
SESSION_SECRET=                       # openssl rand -base64 64

# ===== COOKIE SECURE =====
# In produzione (HTTPS) i cookie sono secure di default. Su un deployment
# HTTP interno (porta in LAN senza reverse proxy HTTPS) impostare
# COOKIE_SECURE=false, altrimenti il refresh-token non verrebbe inviato.
# COOKIE_SECURE=false

# ===== DEPLOYMENT HTTPS =====
# PROD su HTTP interno (LAN, no TLS): lasciare assente o false. Solo con un
# reale deployment HTTPS (certificato + TLS) impostare HTTPS_DEPLOYMENT=true:
# attiva HSTS, upgrade-insecure-requests, COEP require-corp e CSP script-src
# strict. Su HTTP questi header rompono il sito (subresource upgradati a https,
# script inline di Next bloccati → niente idratazione).
# HTTPS_DEPLOYMENT=false

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ===== UPLOAD =====
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=./uploads

# ===== LOGGING =====
LOG_LEVEL=info
LOG_PATH=./logs
LOG_RETENTION_DAYS=30

# ===== ADMIN EMERGENZA =====
BREAK_GLASS_EMAIL=admin@tuo-dominio.it

# ===== SMTP — Email autorizzazione al reso (sistema copiato da ABC HUB) =====
# Usato da server/lib/resi-email.js per inviare testo + HTML alle destinatarie
# fisse quando un reso viene approvato (CS 2° livello + auto-chiuso).
# Il PDF allegato e' stato rimosso (2026-09-16, richiesta operatori).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_TEST_MODE=true
RESI_AUTORIZZAZIONE_EMAIL_ON=1
# RESI_AUTORIZZAZIONE_TO=a@x.it,b@y.it

# ===== EXPORT CORRIERE SU DISCO (file GLS giornaliero) =====
# Default: VUOTO = nessuna scrittura su disco (2026-09-16: niente piu' file di
# recap sparsi sulla Scrivania — il download via browser basta). Per riattivare
# la copia su disco dentro una cartella del progetto (ignorata da git):
# GLS_EXPORT_DIR=./data/exports
# GLS_EXPORT_DIR=

# ===== WEBAUTHN =====
WEBAUTHN_RP_NAME=Resi
WEBAUTHN_RP_ID=resi.tuo-dominio.it
WEBAUTHN_ORIGIN=https://resi.tuo-dominio.it

# ===== WEB PUSH (VAPID) =====
# Genera chiavi con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tuo-dominio.it
