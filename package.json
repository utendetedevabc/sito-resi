{
  "name": "sito-resi",
  "version": "1.0.0",
  "description": "Sito Resi - Gestione resi pubblico con integrazione ABC HUB",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "next build --webpack",
    "start": "NODE_ENV=production node server.js",
    "seed": "node database/seed.js",
    "generate-keys": "node -e \"const { generateKeyPairSync } = require('crypto'); const { writeFileSync, mkdirSync } = require('fs'); mkdirSync('keys', { recursive: true }); const { privateKey, publicKey } = generateKeyPairSync('rsa', { modulusLength: 4096, privateKeyEncoding: { type: 'pkcs1', format: 'pem' }, publicKeyEncoding: { type: 'pkcs1', format: 'pem' } }); writeFileSync('keys/jwt-private.pem', privateKey); writeFileSync('keys/jwt-public.pem', publicKey); console.log('Chiavi JWT generate in ./keys/')\""
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@simplewebauthn/server": "^13.3.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "isomorphic-dompurify": "^2.14.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^16.0.0",
    "nodemailer": "^8.0.0",
    "pdfkit": "^0.17.2",
    "next-pwa": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "web-push": "^3.6.7",
    "winston": "^3.15.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "typescript": "^5.6.0"
  }
}
